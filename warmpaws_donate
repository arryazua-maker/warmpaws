import React, { useState } from 'react';
import { Heart, CreditCard, CheckCircle, AlertCircle, ArrowLeft } from 'lucide-react';

const DonationPage = () => {
  const [currentStep, setCurrentStep] = useState('landing');
  const [donationAmount, setDonationAmount] = useState('');
  const [isCustomAmount, setIsCustomAmount] = useState(false);
  const [donorDetails, setDonorDetails] = useState({ name: '', email: '', cardNumber: '', expiry: '', cvv: '' });
  const [error, setError] = useState('');
  const [isProcessing, setIsProcessing] = useState(false);

  const presetAmounts = [10, 20, 50, 100];

  const handleAmountSelect = (amount) => {
    setDonationAmount(amount.toString());
    setIsCustomAmount(false);
    setError('');
  };

  const handleCustomAmountChange = (e) => {
    const val = e.target.value.replace(/[^0-9]/g, '');
    setDonationAmount(val);
    setIsCustomAmount(true);
    setError('');
  };

  const proceedToPayment = () => {
    if (!donationAmount || parseInt(donationAmount) <= 0) {
      setError('Please select or enter a valid donation amount.');
      return;
    }
    setError('');
    setCurrentStep('payment');
  };

  const handleInputChange = (e) => {
    const { name, value } = e.target;
    setDonorDetails(prev => ({ ...prev, [name]: value }));
  };

  const processPayment = (e) => {
    e.preventDefault();
    const { name, email, cardNumber, expiry, cvv } = donorDetails;

    if (!name || !email || !cardNumber || !expiry || !cvv) {
      setError('Please fill in all payment details.');
      return;
    }

    setError('');
    setIsProcessing(true);

    // Mock payment gateway delay
    setTimeout(() => {
      setIsProcessing(false);
      setCurrentStep('thankyou');
    }, 2000);
  };

  const resetForm = () => {
    setCurrentStep('landing');
    setDonationAmount('');
    setIsCustomAmount(false);
    setDonorDetails({ name: '', email: '', cardNumber: '', expiry: '', cvv: '' });
    setError('');
  };

  const renderLanding = () => (
    <div className="max-w-4xl mx-auto animate-fadeIn relative z-10">
      
      {/* Care & Support Header */}
      <div className="text-center mb-8 pt-4">
        <h1 className="text-5xl md:text-7xl font-extrabold text-[#d9777f] mb-4 drop-shadow-md font-fredoka">
          Care & Support
        </h1>
        <p className="text-xl text-[#b86d5e] font-medium tracking-wide">
          Give Them a Second Chance
        </p>
      </div>

      <div className="text-center mb-12">
        {/* Highlight Quote with Theme Colors */}
        <div className="bg-gradient-to-r from-[#ffe4b5]/80 to-[#ffb6c1]/80 backdrop-blur-md border-l-4 border-[#ff8c69] p-6 rounded-r-2xl shadow-md mb-10 max-w-3xl mx-auto">
          <p className="text-2xl italic font-serif text-[#a65d50]">
            "Being kind to animals is a reflection of our compassion, gratitude, and respect for all life."
          </p>
        </div>
      </div>

      {/* Image Gallery */}
      <div className="grid md:grid-cols-2 gap-6 mb-12">
        <div className="relative group rounded-3xl overflow-hidden shadow-xl border border-white/50">
          <img
            src="https://images.unsplash.com/photo-1534361960057-19889db9621e?auto=format&fit=crop&w=800&q=80"
            alt="Sad looking stray dog"
            className="w-full h-72 object-cover transform transition duration-700 group-hover:scale-105"
          />
          <div className="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition duration-500"></div>
        </div>
        <div className="relative group rounded-3xl overflow-hidden shadow-xl border border-white/50">
          <img
            src="https://images.unsplash.com/photo-1518791841217-8f162f1e1131?auto=format&fit=crop&w=800&q=80"
            alt="Stray cat looking up"
            className="w-full h-72 object-cover transform transition duration-700 group-hover:scale-105"
          />
          <div className="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition duration-500"></div>
        </div>
      </div>

      {/* Donation Selection */}
      <div className="bg-white/60 backdrop-blur-md rounded-3xl shadow-xl p-8 max-w-2xl mx-auto border border-white/40">
        <h3 className="text-2xl font-bold text-[#b86d5e] mb-6 text-center">
          Choose your impact
        </h3>
        
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          {presetAmounts.map((amount) => (
            <button
              key={amount}
              onClick={() => handleAmountSelect(amount)}
              className={`py-3 rounded-xl font-bold text-lg transition-all transform hover:scale-105 ${
                !isCustomAmount && donationAmount === amount.toString()
                  ? 'bg-gradient-to-br from-[#ff8c69] to-[#d9777f] text-white shadow-lg border-transparent'
                  : 'bg-white/80 text-[#a65d50] hover:bg-[#ffd5c2] border border-[#ffb6c1]/50'
              }`}
            >
              RM {amount}
            </button>
          ))}
        </div>

        <div className="mb-6 relative">
          <span className="absolute left-4 top-1/2 -translate-y-1/2 text-[#a65d50] font-bold">RM</span>
          <input
            type="text"
            placeholder="Custom Amount"
            value={isCustomAmount ? donationAmount : ''}
            onChange={handleCustomAmountChange}
            className={`w-full pl-12 pr-4 py-4 rounded-xl bg-white/80 border text-lg focus:outline-none focus:ring-2 focus:ring-[#ff8c69] transition-all shadow-inner ${
              isCustomAmount ? 'border-[#ff8c69] ring-2 ring-[#ff8c69]/30' : 'border-[#ffb6c1]/50'
            }`}
          />
        </div>

        {error && (
          <div className="flex items-center text-red-500 mb-6 bg-red-50/70 backdrop-blur-sm p-4 rounded-xl border border-red-100">
            <AlertCircle size={20} className="mr-2 flex-shrink-0" />
            <span>{error}</span>
          </div>
        )}

        <button
          onClick={proceedToPayment}
          className="w-full bg-gradient-to-r from-[#ff8c69] to-[#d9777f] hover:from-[#ff7a55] hover:to-[#c6626a] text-white font-bold py-5 rounded-2xl shadow-xl transform transition hover:-translate-y-1 flex items-center justify-center space-x-3 text-xl"
        >
          <Heart size={28} className={donationAmount ? "animate-pulse fill-white" : ""} />
          <span>Donate Now</span>
        </button>
      </div>
    </div>
  );

  const renderPayment = () => (
    <div className="max-w-2xl mx-auto animate-fadeIn relative z-10 pt-8">
      <button
        onClick={() => setCurrentStep('landing')}
        className="flex items-center text-[#b86d5e] hover:text-[#d9777f] mb-6 font-semibold transition-colors bg-white/40 px-4 py-2 rounded-full backdrop-blur-sm"
      >
        <ArrowLeft size={20} className="mr-2" />
        Back to amounts
      </button>

      <div className="bg-white/70 backdrop-blur-lg rounded-3xl shadow-2xl overflow-hidden border border-white/50">
        <div className="bg-gradient-to-r from-[#ffd5c2] to-[#ffb6c1] px-8 py-8 text-center border-b border-white/50">
          <h2 className="text-2xl font-bold text-[#a65d50] mb-2">Secure Payment</h2>
          <div className="text-5xl font-extrabold text-[#d9777f] drop-shadow-sm">RM {donationAmount}</div>
        </div>

        <form onSubmit={processPayment} className="p-8 space-y-6">
          <div>
            <label className="block text-[#b86d5e] font-bold mb-2">Full Name</label>
            <input
              type="text"
              name="name"
              value={donorDetails.name}
              onChange={handleInputChange}
              className="w-full px-4 py-3 rounded-xl bg-white/80 border border-[#ffb6c1]/50 focus:outline-none focus:ring-2 focus:ring-[#ff8c69] shadow-inner"
              placeholder="John Doe"
            />
          </div>

          <div>
            <label className="block text-[#b86d5e] font-bold mb-2">Email Address</label>
            <input
              type="email"
              name="email"
              value={donorDetails.email}
              onChange={handleInputChange}
              className="w-full px-4 py-3 rounded-xl bg-white/80 border border-[#ffb6c1]/50 focus:outline-none focus:ring-2 focus:ring-[#ff8c69] shadow-inner"
              placeholder="john@example.com"
            />
          </div>

          <div className="pt-6 border-t border-[#ffb6c1]/40 mt-6">
            <label className="block text-[#b86d5e] font-bold mb-3">Card Details</label>
            <div className="relative mb-4">
              <CreditCard className="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" size={20} />
              <input
                type="text"
                name="cardNumber"
                value={donorDetails.cardNumber}
                onChange={handleInputChange}
                className="w-full pl-12 pr-4 py-3 rounded-xl bg-white/80 border border-[#ffb6c1]/50 focus:outline-none focus:ring-2 focus:ring-[#ff8c69] shadow-inner"
                placeholder="0000 0000 0000 0000"
              />
            </div>
            <div className="grid grid-cols-2 gap-4">
              <input
                type="text"
                name="expiry"
                value={donorDetails.expiry}
                onChange={handleInputChange}
                className="w-full px-4 py-3 rounded-xl bg-white/80 border border-[#ffb6c1]/50 focus:outline-none focus:ring-2 focus:ring-[#ff8c69] shadow-inner"
                placeholder="MM/YY"
              />
              <input
                type="text"
                name="cvv"
                value={donorDetails.cvv}
                onChange={handleInputChange}
                className="w-full px-4 py-3 rounded-xl bg-white/80 border border-[#ffb6c1]/50 focus:outline-none focus:ring-2 focus:ring-[#ff8c69] shadow-inner"
                placeholder="CVV"
              />
            </div>
          </div>

          {error && (
            <div className="flex items-center text-red-500 bg-red-50/70 backdrop-blur-sm p-4 rounded-xl border border-red-100">
              <AlertCircle size={20} className="mr-2 flex-shrink-0" />
              <span>{error}</span>
            </div>
          )}

          <button
            type="submit"
            disabled={isProcessing}
            className="w-full bg-gradient-to-r from-[#ff8c69] to-[#d9777f] hover:from-[#ff7a55] hover:to-[#c6626a] text-white font-bold py-5 rounded-2xl shadow-xl transition-all transform hover:-translate-y-1 disabled:opacity-70 disabled:cursor-not-allowed disabled:transform-none flex items-center justify-center text-xl mt-8"
          >
            {isProcessing ? (
              <span className="flex items-center">
                <svg className="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                  <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Processing...
              </span>
            ) : (
              <span>Complete Donation of RM {donationAmount}</span>
            )}
          </button>
        </form>
      </div>
    </div>
  );

  const renderThankYou = () => (
    <div className="max-w-2xl mx-auto text-center animate-fadeIn py-12 relative z-10">
      <div className="bg-white/70 backdrop-blur-xl rounded-3xl shadow-2xl p-12 border border-white/50">
        <div className="flex justify-center mb-8">
          <div className="rounded-full bg-gradient-to-br from-[#ffd5c2] to-[#ffb6c1] p-6 shadow-inner">
            <CheckCircle size={80} className="text-[#a65d50]" />
          </div>
        </div>
        <h2 className="text-5xl font-extrabold text-[#d9777f] mb-6 drop-shadow-sm">
          Thank You!
        </h2>
        <p className="text-xl text-[#b86d5e] mb-10 leading-relaxed font-medium">
          Your generous donation of <strong className="text-[#a65d50] text-2xl">RM {donationAmount}</strong> has been successfully processed. 
          Because of kind hearts like yours, we can continue to give these animals the care and love they deserve.
        </p>
        
        <div className="grid grid-cols-2 gap-6 mb-10">
          <div className="rounded-2xl overflow-hidden shadow-lg border border-white/50">
             <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=400&q=80" alt="Happy adopted dog" className="w-full h-40 object-cover" />
          </div>
          <div className="rounded-2xl overflow-hidden shadow-lg border border-white/50">
             <img src="https://images.unsplash.com/photo-1526336024174-e58f5cdd8e13?auto=format&fit=crop&w=400&q=80" alt="Happy comfortable cat" className="w-full h-40 object-cover" />
          </div>
        </div>
        
        <button
          onClick={resetForm}
          className="bg-white/80 text-[#b86d5e] hover:bg-[#ffd5c2] hover:text-[#a65d50] border border-[#ffb6c1] font-bold py-4 px-10 rounded-2xl shadow-md transition-all transform hover:-translate-y-1 text-lg"
        >
          Return Home
        </button>
      </div>
    </div>
  );

  return (
    <div 
      className="min-h-screen flex flex-col font-sans relative"
      style={{
        backgroundImage: `url('warmpawsmainbackground.png')`,
        backgroundSize: 'cover',
        backgroundPosition: 'center',
        backgroundAttachment: 'fixed',
        backgroundColor: '#fef1e6'
      }}
    >
      {/* Main Content Area */}
      <main className="max-w-6xl mx-auto px-4 py-8 md:py-12 flex-grow w-full relative z-10 flex flex-col justify-center">
        {currentStep === 'landing' && renderLanding()}
        {currentStep === 'payment' && renderPayment()}
        {currentStep === 'thankyou' && renderThankYou()}
      </main>

      {/* Footer */}
      <footer className="py-6 relative z-10 border-t border-white/30 bg-white/20 backdrop-blur-sm mt-auto">
        <div className="max-w-6xl mx-auto px-4 text-center">
          <p className="font-bold text-lg text-[#d9777f] tracking-wider">
            WarmPaws : Rescue.Shelter.Adopt.Love
          </p>
        </div>
      </footer>
    </div>
  );
};

export default DonationPage;
